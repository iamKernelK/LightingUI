            ZIndex = 102,
            Parent = InputFrame
        })
    end

    local RInput = CreateColorInput("R", 15, math.floor(DefaultColor.R * 255))
    local GInput = CreateColorInput("G", 80, math.floor(DefaultColor.G * 255))
    local BInput = CreateColorInput("B", 145, math.floor(DefaultColor.B * 255))

    local ConfirmBtn = Utility:Create("TextButton", {
        Size = UDim2.new(0, 80, 0, 32),
        Position = UDim2.new(0, 15, 0, 255),
        BackgroundColor3 = Theme.Accent,
        Text = "Apply", TextColor3 = Theme.Text,
        Font = Enum.Font.GothamBold, TextSize = 12,
        ZIndex = 101,
        Parent = PickerFrame
    })
    Utility:Create("UICorner", {CornerRadius = UDim.new(0, 8), Parent = ConfirmBtn})

    local CancelBtn = Utility:Create("TextButton", {
        Size = UDim2.new(0, 80, 0, 32),
        Position = UDim2.new(0, 105, 0, 255),
        BackgroundColor3 = Theme.ElementBg,
        Text = "Cancel", TextColor3 = Theme.TextMuted,
        Font = Enum.Font.GothamBold, TextSize = 12,
        ZIndex = 101,
        Parent = PickerFrame
    })
    Utility:Create("UICorner", {CornerRadius = UDim.new(0, 8), Parent = CancelBtn})
    Utility:Create("UIStroke", {Color = Theme.Stroke, Thickness = 1, Parent = CancelBtn})

    local H, S, V = DefaultColor:ToHSV()
    local CurrentColor = DefaultColor
    local IsOpen = false

    local function UpdateColorFromHSV()
        CurrentColor = Color3.fromHSV(H, S, V)
        ColorDisplay.BackgroundColor3 = CurrentColor
        HexLabel.Text = string.format("#%02X%02X%02X", CurrentColor.R * 255, CurrentColor.G * 255, CurrentColor.B * 255)
        RInput.Text = tostring(math.floor(CurrentColor.R * 255))
        GInput.Text = tostring(math.floor(CurrentColor.G * 255))
        BInput.Text = tostring(math.floor(CurrentColor.B * 255))
        SBFrame.BackgroundColor3 = Color3.fromHSV(H, 1, 1)
        Callback(CurrentColor)
    end

    local function UpdateFromRGB()
        local r = math.clamp(tonumber(RInput.Text) or 0, 0, 255) / 255
        local g = math.clamp(tonumber(GInput.Text) or 0, 0, 255) / 255
        local b = math.clamp(tonumber(BInput.Text) or 0, 0, 255) / 255
        H, S, V = Color3.new(r, g, b):ToHSV()
        SBCursor.Position = UDim2.new(S, 0, 1 - V, 0)
        HueCursor.Position = UDim2.new(H, 0, 0.5, 0)
        UpdateColorFromHSV()
    end

    SBCursor.Position = UDim2.new(S, 0, 1 - V, 0)
    HueCursor.Position = UDim2.new(H, 0, 0.5, 0)

    local SbDragging, HueDragging = false, false

    SBFrame.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            SbDragging = true
            local relX = math.clamp((input.Position.X - SBFrame.AbsolutePosition.X) / SBFrame.AbsoluteSize.X, 0, 1)
            local relY = math.clamp((input.Position.Y - SBFrame.AbsolutePosition.Y) / SBFrame.AbsoluteSize.Y, 0, 1)
            S, V = relX, 1 - relY
            SBCursor.Position = UDim2.new(S, 0, 1 - V, 0)
            UpdateColorFromHSV()
        end
    end)

    SBFrame.InputChanged:Connect(function(input)
        if SbDragging and input.UserInputType == Enum.UserInputType.MouseMovement then
            local relX = math.clamp((input.Position.X - SBFrame.AbsolutePosition.X) / SBFrame.AbsoluteSize.X, 0, 1)
            local relY = math.clamp((input.Position.Y - SBFrame.AbsolutePosition.Y) / SBFrame.AbsoluteSize.Y, 0, 1)
            S, V = relX, 1 - relY
            SBCursor.Position = UDim2.new(S, 0, 1 - V, 0)
            UpdateColorFromHSV()
        end
    end)

    HueFrame.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            HueDragging = true
            H = math.clamp((input.Position.X - HueFrame.AbsolutePosition.X) / HueFrame.AbsoluteSize.X, 0, 1)
            HueCursor.Position = UDim2.new(H, 0, 0.5, 0)
            UpdateColorFromHSV()
        end
    end)

    HueFrame.InputChanged:Connect(function(input)
        if HueDragging and input.UserInputType == Enum.UserInputType.MouseMovement then
            H = math.clamp((input.Position.X - HueFrame.AbsolutePosition.X) / HueFrame.AbsoluteSize.X, 0, 1)
            HueCursor.Position = UDim2.new(H, 0, 0.5, 0)
            UpdateColorFromHSV()
        end
    end)

    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            SbDragging, HueDragging = false, false
        end
    end)

    RInput.FocusLost:Connect(UpdateFromRGB)
    GInput.FocusLost:Connect(UpdateFromRGB)
    BInput.FocusLost:Connect(UpdateFromRGB)

    local function TogglePicker()
        IsOpen = not IsOpen
        if IsOpen then
            PickerFrame.Visible = true
            TweenService:Create(PickerFrame, TweenInfo.new(0.3, Enum.EasingStyle.Quart), {
                Size = UDim2.new(0, 280, 0, 300)
            }):Play()
            TweenService:Create(Stroke, TweenInfo.new(0.2), {Color = Theme.StrokeAccent}):Play()
        else
            TweenService:Create(PickerFrame, TweenInfo.new(0.3, Enum.EasingStyle.Quart), {
                Size = UDim2.new(0, 280, 0, 0)
            }):Play()
            TweenService:Create(Stroke, TweenInfo.new(0.2), {Color = Theme.Stroke}):Play()
            task.delay(0.3, function()
                if not IsOpen then PickerFrame.Visible = false end
            end)
        end
    end

    ColorDisplay.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then TogglePicker() end
    end)

    ConfirmBtn.MouseButton1Click:Connect(function()
        TogglePicker()
        LightningUI:Notify("Success", "Color Updated", "Color has been applied successfully!", 2)
    end)

    CancelBtn.MouseButton1Click:Connect(TogglePicker)

    Container.MouseEnter:Connect(function()
        TweenService:Create(Stroke, TweenInfo.new(0.2), {Color = Theme.StrokeHover}):Play()
    end)
    Container.MouseLeave:Connect(function()
        if not IsOpen then TweenService:Create(Stroke, TweenInfo.new(0.2), {Color = Theme.Stroke}):Play() end
    end)

    return Container
end

