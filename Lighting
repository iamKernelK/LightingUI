                TweenService:Create(ItemBtn, TweenInfo.new(0.15), {BackgroundColor3 = Color3.fromRGB(35, 25, 18)}):Play()
                TweenService:Create(ItemBtn, TweenInfo.new(0.15), {TextColor3 = THEME_ORANGE}):Play()
            end)
            ItemBtn.MouseLeave:Connect(function()
                TweenService:Create(ItemBtn, TweenInfo.new(0.15), {BackgroundColor3 = Color3.fromRGB(20, 15, 12)}):Play()
                TweenService:Create(ItemBtn, TweenInfo.new(0.15), {TextColor3 = TEXT_COLOR}):Play()
            end)
            ItemBtn.MouseButton1Click:Connect(function()
                ValueBtn.Text = item
                Callback(item)
                isOpen = false
                TweenService:Create(ArrowIcon, TweenInfo.new(0.2), {Rotation = 90}):Play()
                TweenService:Create(ListContainer, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Size = UDim2.new(0, 140, 0, 0)}):Play()
                task.delay(0.2, function() ListContainer.Visible = false end)
            end)
        end
    end

    BuildList()

    ValueBtn.MouseButton1Click:Connect(function()
        isOpen = not isOpen
        if isOpen then
            ListContainer.Visible = true
            local listHeight = math.min(#Items * 30 + 8, 200)
            TweenService:Create(ArrowIcon, TweenInfo.new(0.2), {Rotation = -90}):Play()
            TweenService:Create(ListContainer, TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Size = UDim2.new(0, 140, 0, listHeight)}):Play()
        else
            TweenService:Create(ArrowIcon, TweenInfo.new(0.2), {Rotation = 90}):Play()
            TweenService:Create(ListContainer, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Size = UDim2.new(0, 140, 0, 0)}):Play()
            task.delay(0.2, function() ListContainer.Visible = false end)
        end
    end)

    DropdownFrame.MouseEnter:Connect(function()
        TweenService:Create(DropdownFrame, TweenInfo.new(0.2), {BackgroundColor3 = ELEMENT_HOVER}):Play()
    end)
    DropdownFrame.MouseLeave:Connect(function()
        TweenService:Create(DropdownFrame, TweenInfo.new(0.2), {BackgroundColor3 = ELEMENT_BG}):Play()
    end)

    -- Close dropdown when clicking outside
    UserInputService.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 and isOpen then
            local pos = input.Position
            local absPos = ListContainer.AbsolutePosition
            local absSize = ListContainer.AbsoluteSize
            if pos.X < absPos.X or pos.X > absPos.X + absSize.X or pos.Y < absPos.Y or pos.Y > absPos.Y + absSize.Y then
                local btnPos = ValueBtn.AbsolutePosition
                local btnSize = ValueBtn.AbsoluteSize
                if pos.X < btnPos.X or pos.X > btnPos.X + btnSize.X or pos.Y < btnPos.Y or pos.Y > btnPos.Y + btnSize.Y then
                    isOpen = false
                    TweenService:Create(ArrowIcon, TweenInfo.new(0.2), {Rotation = 90}):Play()
                    TweenService:Create(ListContainer, TweenInfo.new(0.2), {Size = UDim2.new(0, 140, 0, 0)}):Play()
                    task.delay(0.2, function() ListContainer.Visible = false end)
                end
            end
        end
    end)

    return DropdownFrame
end

===============END===============


