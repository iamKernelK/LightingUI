--                      INFO (Display Label)
-- ═══════════════════════════════════════════════════════════════
-- ═══════════════════════════════════════════════════════════════

function AxisUI:CreateInfo(ParentFrame, Options)
    local Name = Options.Name or "Info"
    local Description = Options.Description or ""
    local IconId = Options.Icon
    local TxtColor = Options.TextColor or TEXT_SELECTED
    local DescColor = Options.DescColor or Color3.fromRGB(130, 130, 130)

    local InfoFrame = Instance.new("Frame")
    InfoFrame.Name = Name .. "_Info"
    InfoFrame.Size = UDim2.new(1, 0, 0, Description ~= "" and 52 or 32)
    InfoFrame.BackgroundColor3 = ELEMENT_BG
    InfoFrame.BackgroundTransparency = 0.5
    InfoFrame.Parent = ParentFrame

    Instance.new("UICorner", InfoFrame).CornerRadius = UDim.new(0, 8)

    local Stroke = Instance.new("UIStroke")
    Stroke.Color = THEME_ORANGE
    Stroke.Thickness = 1
    Stroke.Transparency = 0.9
    Stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    Stroke.Parent = InfoFrame

    local titleOffset = 15
    if IconId then
        local LeftIcon = Instance.new("ImageLabel")
        LeftIcon.Size = UDim2.new(0, 20, 0, 20)
        LeftIcon.Position = UDim2.new(0, 15, 0, Description ~= "" and 10 or 6)
        LeftIcon.AnchorPoint = Vector2.new(0, 0)
        LeftIcon.BackgroundTransparency = 1
        LeftIcon.Image = IconId
        LeftIcon.ImageColor3 = THEME_ORANGE
        LeftIcon.Parent = InfoFrame
        titleOffset = 45
    end

    local Title = Instance.new("TextLabel")
    Title.Size = UDim2.new(1, -titleOffset - 10, 0, 20)
    Title.Position = UDim2.new(0, titleOffset, 0, 6)
    Title.BackgroundTransparency = 1
    Title.Text = Name
    Title.TextColor3 = TxtColor
    Title.Font = Enum.Font.GothamBold
    Title.TextSize = 13
    Title.TextXAlignment = Enum.TextXAlignment.Left
    Title.Parent = InfoFrame

    if Description ~= "" then
        local Desc = Instance.new("TextLabel")
        Desc.Size = UDim2.new(1, -titleOffset - 10, 0, 18)
        Desc.Position = UDim2.new(0, titleOffset, 0, 28)
        Desc.BackgroundTransparency = 1
        Desc.Text = Description
        Desc.TextColor3 = DescColor
        Desc.Font = Enum.Font.GothamMedium
        Desc.TextSize = 11
        Desc.TextXAlignment = Enum.TextXAlignment.Left
        Desc.TextWrapped = true
        Desc.Parent = InfoFrame
    end

    return InfoFrame
end

