                Size = UDim2.new(1, 0, 0, 0), Position = UDim2.new(0, 0, 0, 40), BackgroundTransparency = 1, AutomaticSize = Enum.AutomaticSize.Y, Parent = SecFrame
            })
            local layout = Utility:Create("UIListLayout", {Padding = UDim.new(0, 6), Parent = SecContent})
