                TextSize = 12,
                Parent = SliFrame
            })
            Utility:Create("UICorner", {CornerRadius = UDim.new(0, 6), Parent = ValueBox})

            Utility:Create("TextLabel", {
                Size = UDim2.new(0, 30, 0, 14),
                Position = UDim2.new(0, 15, 0, 52),
                BackgroundTransparency = 1,
                Text = tostring(Min),
                TextColor3 = Theme.TextMuted,
                Font = Enum.Font.GothamMedium,
                TextSize = 10,
                Parent = SliFrame
            })
            Utility:Create("TextLabel", {
                Size = UDim2.new(0, 30, 0, 14),
                Position = UDim2.new(1, -45, 0, 52),
                BackgroundTransparency = 1,
                Text = tostring(Max),
                TextColor3 = Theme.TextMuted,
                Font = Enum.Font.GothamMedium,
                TextSize = 10,
                TextXAlignment = Enum.TextXAlignment.Right,
                Parent = SliFrame
            })

            local Track = Utility:Create("TextButton", {
                Size = UDim2.new(1, -60, 0, 8),
                Position = UDim2.new(0, 30, 0, 40),
                BackgroundColor3 = Theme.SliderTrack,
                Text = "",
                AutoButtonColor = false,
                Parent = SliFrame
            })
            Utility:Create("UICorner", {CornerRadius = UDim.new(1, 0), Parent = Track})

            local Fill = Utility:Create("Frame", {
                Size = UDim2.new((Default - Min) / (Max - Min), 0, 1, 0),
                BackgroundColor3 = Theme.SliderFill,
                BorderSizePixel = 0,
                Parent = Track
            })
            Utility:Create("UICorner", {CornerRadius = UDim.new(1, 0), Parent = Fill})

            local Thumb = Utility:Create("Frame", {
                Size = UDim2.new(0, 18, 0, 18),
                Position = UDim2.new((Default - Min) / (Max - Min), -9, 0, -5),
                BackgroundColor3 = Color3.new(1, 1, 1),
                BorderSizePixel = 0,
                Parent = Track
            })
            Utility:Create("UICorner", {CornerRadius = UDim.new(1, 0), Parent = Thumb})
            Utility:Create("UIStroke", {
                Color = Theme.Accent,
                Thickness = 2.5,
                Parent = Thumb
            })

            local ThumbGlow = Utility:Create("Frame", {
                Size = UDim2.new(1, 8, 1, 8),
                Position = UDim2.new(0, -4, 0, -4),
                BackgroundColor3 = Theme.Accent,
                BackgroundTransparency = 0.85,
                BorderSizePixel = 0,
                Parent = Thumb
            })
            Utility:Create("UICorner", {CornerRadius = UDim.new(1, 0), Parent = ThumbGlow})

            local dragging = false
            local function UpdateSlider(input)
                local pct = math.clamp((input.Position.X - Track.AbsolutePosition.X) / Track.AbsoluteSize.X, 0, 1)
                local val = math.floor(Min + (pct * (Max - Min)))
                TweenService:Create(Fill, TweenInfo.new(0.1), {Size = UDim2.new(pct, 0, 1, 0)}):Play()
                TweenService:Create(Thumb, TweenInfo.new(0.1), {
                    Position = UDim2.new(pct, -9, 0, -5)
                }):Play()
                ValueBox.Text = tostring(val) .. Suffix
                Callback(val)
            end

            Track.InputBegan:Connect(function(inp)
                if inp.UserInputType == Enum.UserInputType.MouseButton1 then
                    dragging = true
                    UpdateSlider(inp)
                end
            end)
            UserInputService.InputEnded:Connect(function(inp)
                if inp.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end
            end)
            UserInputService.InputChanged:Connect(function(inp)
                if dragging and inp.UserInputType == Enum.UserInputType.MouseMovement then UpdateSlider(inp) end
            end)

            SliFrame.MouseEnter:Connect(function()
                TweenService:Create(sliStroke, TweenInfo.new(0.2), {Color = Theme.StrokeHover}):Play()
                TweenService:Create(SliFrame, TweenInfo.new(0.2), {BackgroundColor3 = Theme.ElementBgHover}):Play()
            end)
            SliFrame.MouseLeave:Connect(function()
                TweenService:Create(sliStroke, TweenInfo.new(0.2), {Color = Theme.Stroke}):Play()
                TweenService:Create(SliFrame, TweenInfo.new(0.2), {BackgroundColor3 = Theme.ElementBg}):Play()
            end)

            return SliFrame
        end

