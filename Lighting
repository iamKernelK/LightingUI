local Utility = {}

function Utility:Create(className, properties)
    local inst = Instance.new(className)
    for k, v in pairs(properties) do
        inst[k] = v
    end
    return inst
end

function Utility:AddRipple(button)
    local ripple = self:Create("Frame", {
        BackgroundColor3 = Theme.Accent,
        BackgroundTransparency = 0.8,
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.new(0.5, 0, 0.5, 0),
        Size = UDim2.new(0, 0, 0, 0),
        Parent = button
    })
    self:Create("UICorner", {CornerRadius = UDim.new(1, 0), Parent = ripple})
    local targetSize = math.max(button.AbsoluteSize.X, button.AbsoluteSize.Y) * 1.5
    local tw = TweenService:Create(ripple, TweenInfo.new(0.4, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
        Size = UDim2.new(0, targetSize, 0, targetSize),
        BackgroundTransparency = 1
    })
    tw:Play()
    tw.Completed:Connect(function() ripple:Destroy() end)
end

function Utility:RegisterStroke(stroke)
    table.insert(UIStrokes, stroke)
end

-- Animate all registered strokes
RunService.RenderStepped:Connect(function()
    local time = tick() % 5 / 5
    for _, stroke in ipairs(UIStrokes) do
        if stroke and stroke.Parent then
            local grad = stroke:FindFirstChildOfClass("UIGradient")
            if grad then
                grad.Rotation = time * 360
            end
        end
    end
end)

