                Size = UDim2.new(0, 0, 0, 200), BackgroundColor3 = Theme.DropdownBg, Visible = false, ZIndex = 100, Parent = ScreenGui
            })
            Utility:Create("UICorner", {CornerRadius = UDim.new(0, 6), Parent = Overlay})
            Utility:Create("UIStroke", {Color = Theme.Accent, Thickness = 1.5, Parent = Overlay})
            
            local SearchBox = Utility:Create("TextBox", {
                Size = UDim2.new(1, -20, 0, 30), Position = UDim2.new(0, 10, 0, 10), BackgroundColor3 = Theme.Background, TextColor3 = Theme.Text,
                PlaceholderText = "Search...", Text = "", Font = Enum.Font.GothamMedium, TextSize = 12, ZIndex = 101, Parent = Overlay
            })
            Utility:Create("UICorner", {CornerRadius = UDim.new(0, 4), Parent = SearchBox})

            local ItemScroll = Utility:Create("ScrollingFrame", {
                Size = UDim2.new(1, -10, 1, -50), Position = UDim2.new(0, 5, 0, 45), BackgroundTransparency = 1, ScrollBarThickness = 2, ZIndex = 101, Parent = Overlay
            })
            Utility:Create("UIListLayout", {Padding = UDim.new(0, 5), Parent = ItemScroll})

            local isOpen = false
            local function Refresh(filter)
                for _, v in ipairs(ItemScroll:GetChildren()) do if v:IsA("TextButton") then v:Destroy() end end
                for _, item in ipairs(List) do
                    if not filter or filter == "" or string.find(string.lower(item), string.lower(filter)) then
                        local btn = Utility:Create("TextButton", {
                            Size = UDim2.new(1, -10, 0, 30), Position = UDim2.new(0, 5, 0, 0), BackgroundColor3 = Theme.ElementBg, Text = "  " .. item,
                            TextColor3 = Theme.Text, Font = Enum.Font.GothamMedium, TextSize = 13, TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 102, Parent = ItemScroll
                        })
                        Utility:Create("UICorner", {CornerRadius = UDim.new(0, 4), Parent = btn})
                        btn.MouseButton1Click:Connect(function()
                            SelectedTxt.Text = item; isOpen = false; Overlay.Visible = false
                            TweenService:Create(Arrow, TweenInfo.new(0.2), {Rotation = 0}):Play()
                            Callback(item)
                        end)
                    end
                end
                ItemScroll.CanvasSize = UDim2.new(0,0,0, #ItemScroll:GetChildren() * 35)
            end

            SearchBox:GetPropertyChangedSignal("Text"):Connect(function() Refresh(SearchBox.Text) end)

            DropBtn.MouseButton1Click:Connect(function()
                isOpen = not isOpen
                if isOpen then
                    local absPos = DropBtn.AbsolutePosition
                    Overlay.Size = UDim2.new(0, DropBtn.AbsoluteSize.X, 0, 200)
                    Overlay.Position = UDim2.new(0, absPos.X, 0, absPos.Y + 50)
                    Refresh()
                    Overlay.Visible = true
                    TweenService:Create(Arrow, TweenInfo.new(0.3), {Rotation = 90}):Play()
                else
                    Overlay.Visible = false
                    TweenService:Create(Arrow, TweenInfo.new(0.3), {Rotation = 0}):Play()
                end
            end)

            UserInputService.InputBegan:Connect(function(input)
                if isOpen and input.UserInputType == Enum.UserInputType.MouseButton1 then
                    local mx, my = input.Position.X, input.Position.Y
                    local px, py = Overlay.AbsolutePosition.X, Overlay.AbsolutePosition.Y
                    local sx, sy = Overlay.AbsoluteSize.X, Overlay.AbsoluteSize.Y
                    local bx, by = DropBtn.AbsolutePosition.X, DropBtn.AbsolutePosition.Y
                    local bsx, bsy = DropBtn.AbsoluteSize.X, DropBtn.AbsoluteSize.Y
                    if not (mx >= px and mx <= px + sx and my >= py and my <= py + sy) and not (mx >= bx and mx <= bx + bsx and my >= by and my <= by + bsy) then
                        isOpen = false; Overlay.Visible = false
                        TweenService:Create(Arrow, TweenInfo.new(0.3), {Rotation = 0}):Play()
                    end
                end
            end)
            
            RegisterElement(Name, function() DropBtn.MouseButton1Click:Fire() end)
        end

        -- 6. Code Block (Read-only message block)
        function Tab:CreateCode(Text, ParentTarget)
            local target = GetTarget(ParentTarget)
            local CodeFrame = Utility:Create("Frame", {
                Size = UDim2.new(1, 0, 0, 45), BackgroundColor3 = Color3.fromRGB(10, 10, 15), Parent = target
            })
            Utility:Create("UICorner", {CornerRadius = UDim.new(0, 6), Parent = CodeFrame})
            Utility:Create("UIStroke", {Color = Theme.AccentDark, Parent = CodeFrame})

            Utility:Create("TextLabel", {
                Size = UDim2.new(1, -20, 1, 0), Position = UDim2.new(0, 10, 0, 0), BackgroundTransparency = 1,
                Text = Text, TextColor3 = Color3.fromRGB(150, 220, 150), Font = Enum.Font.Code, TextSize = 13, TextXAlignment = Enum.TextXAlignment.Left, Parent = CodeFrame
            })
        end
        
        -- 7. Paragraph
        function Tab:CreateParagraph(Title, Desc, ParentTarget)
            local target = GetTarget(ParentTarget)
            local Para = Utility:Create("Frame", {
                Size = UDim2.new(1, 0, 0, 55), BackgroundColor3 = Theme.Background, Parent = target
            })
            Utility:Create("UICorner", {CornerRadius = UDim.new(0, 6), Parent = Para})
            
            Utility:Create("TextLabel", {
                Size = UDim2.new(1, -20, 0, 20), Position = UDim2.new(0, 10, 0, 5), BackgroundTransparency = 1,
                Text = Title, TextColor3 = Theme.Text, Font = Enum.Font.GothamBold, TextSize = 14, TextXAlignment = Enum.TextXAlignment.Left, Parent = Para
            })
            Utility:Create("TextLabel", {
                Size = UDim2.new(1, -20, 0, 20), Position = UDim2.new(0, 10, 0, 25), BackgroundTransparency = 1,
                Text = Desc, TextColor3 = Theme.TextMuted, Font = Enum.Font.GothamMedium, TextSize = 12, TextXAlignment = Enum.TextXAlignment.Left, Parent = Para
            })
        end

        return Tab
    end

    return Window
end

return LightningUI
