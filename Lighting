        -- DROPDOWN (Legendary - Like Reference Image)
        -- ═══════════════════════════════════════════════════════════════════════
        function Tab:CreateDropdown(Options, ParentTarget)
            local target = GetTarget(ParentTarget)
            local Name = Options.Name or "Dropdown"
            local List = Options.Options or {}
            local Callback = Options.Callback or function() end

            local DropFrame = Utility:Create("Frame", {
                Size = UDim2.new(1, 0, 0, 52),
                BackgroundColor3 = Theme.ElementBg,
                BorderSizePixel = 0,
                Parent = target
            })
            Utility:Create("UICorner", {CornerRadius = UDim.new(0, 10), Parent = DropFrame})

            local dropStroke = Utility:Create("UIStroke", {
                Color = Theme.Stroke,
                Thickness = 1,
                Parent = DropFrame
            })

            Utility:Create("TextLabel", {
                Size = UDim2.new(0, 200, 0, 20),
                Position = UDim2.new(0, 15, 0, 6),
                BackgroundTransparency = 1,
                Text = Name,
                TextColor3 = Theme.Text,
                Font = Enum.Font.GothamMedium,
                TextSize = 14,
                TextXAlignment = Enum.TextXAlignment.Left,
                Parent = DropFrame
            })

            local SelectedTxt = Utility:Create("TextLabel", {
                Size = UDim2.new(1, -50, 0, 18),
                Position = UDim2.new(0, 15, 0, 26),
                BackgroundTransparency = 1,
                Text = "Click to select...",
                TextColor3 = Theme.TextMuted,
                Font = Enum.Font.GothamMedium,
                TextSize = 12,
                TextXAlignment = Enum.TextXAlignment.Left,
                Parent = DropFrame
            })

            local DropBtn = Utility:Create("TextButton", {
                Size = UDim2.new(1, 0, 1, 0),
                BackgroundTransparency = 1,
                Text = "",
                Parent = DropFrame
            })

            local Arrow = Utility:Create("ImageLabel", {
                Size = UDim2.new(0, 16, 0, 16),
                Position = UDim2.new(1, -28, 0.5, -8),
                BackgroundTransparency = 1,
                Image = "rbxassetid://4897435048",
                ImageColor3 = Theme.TextMuted,
                Rotation = 0,
                Parent = DropFrame
            })

            -- Dropdown Menu (expands inside like reference image)
            local DropMenu = Utility:Create("Frame", {
                Size = UDim2.new(1, 0, 0, 0),
                Position = UDim2.new(0, 0, 0, 54),
                BackgroundColor3 = Theme.DropdownBg,
                ClipsDescendants = true,
                Visible = false,
                ZIndex = 50,
                Parent = DropFrame
            })
            Utility:Create("UICorner", {CornerRadius = UDim.new(0, 10), Parent = DropMenu})

            local menuStroke = Utility:Create("UIStroke", {
                Color = Theme.StrokeAccent,
                Thickness = 1.5,
                Parent = DropMenu
            })

            -- Search inside dropdown
            local SearchBox = Utility:Create("TextBox", {
                Size = UDim2.new(1, -20, 0, 32),
                Position = UDim2.new(0, 10, 0, 10),
                BackgroundColor3 = Theme.Background,
                TextColor3 = Theme.Text,
                PlaceholderText = "🔍 Search...",
                Text = "",
                Font = Enum.Font.GothamMedium,
                TextSize = 12,
                ZIndex = 51,
                Parent = DropMenu
            })
            Utility:Create("UICorner", {CornerRadius = UDim.new(0, 6), Parent = SearchBox})

            local ItemContainer = Utility:Create("ScrollingFrame", {
                Size = UDim2.new(1, -10, 1, -55),
                Position = UDim2.new(0, 5, 0, 48),
                BackgroundTransparency = 1,
                ScrollBarThickness = 2,
                ZIndex = 51,
                Parent = DropMenu
            })
            Utility:Create("UIListLayout", {Padding = UDim.new(0, 4), Parent = ItemContainer})

            local isOpen = false
            local function Refresh(filter)
                for _, v in ipairs(ItemContainer:GetChildren()) do
                    if v:IsA("TextButton") then v:Destroy() end
                end

                local itemCount = 0
                for _, item in ipairs(List) do
                    if not filter or filter == "" or string.find(string.lower(item), string.lower(filter), 1, true) then
                        itemCount = itemCount + 1
                        local btn = Utility:Create("TextButton", {
                            Size = UDim2.new(1, -10, 0, 34),
                            Position = UDim2.new(0, 5, 0, 0),
                            BackgroundColor3 = Theme.DropdownItem,
                            Text = "  " .. item,
                            TextColor3 = Theme.Text,
                            Font = Enum.Font.GothamMedium,
                            TextSize = 13,
                            TextXAlignment = Enum.TextXAlignment.Left,
                            ZIndex = 52,
                            Parent = ItemContainer
                        })
                        Utility:Create("UICorner", {CornerRadius = UDim.new(0, 6), Parent = btn})

                        btn.MouseEnter:Connect(function()
                            TweenService:Create(btn, TweenInfo.new(0.15), {BackgroundColor3 = Theme.DropdownItemHover}):Play()
                        end)
                        btn.MouseLeave:Connect(function()
                            TweenService:Create(btn, TweenInfo.new(0.15), {BackgroundColor3 = Theme.DropdownItem}):Play()
                        end)

                        btn.MouseButton1Click:Connect(function()
                            SelectedTxt.Text = item
                            SelectedTxt.TextColor3 = Theme.Accent
                            isOpen = false
                            TweenService:Create(DropMenu, TweenInfo.new(0.3), {
                                Size = UDim2.new(1, 0, 0, 0)
                            }):Play()
                            TweenService:Create(Arrow, TweenInfo.new(0.3), {Rotation = 0}):Play()
                            Callback(item)
                        end)
                    end
                end

                ItemContainer.CanvasSize = UDim2.new(0, 0, 0, itemCount * 38)

                local menuHeight = math.min(48 + itemCount * 38 + 10, 220)
                if isOpen then
                    TweenService:Create(DropMenu, TweenInfo.new(0.3), {
                        Size = UDim2.new(1, 0, 0, menuHeight)
                    }):Play()
                end
            end

            SearchBox:GetPropertyChangedSignal("Text"):Connect(function()
                Refresh(SearchBox.Text)
            end)

            DropBtn.MouseButton1Click:Connect(function()
                isOpen = not isOpen
                if isOpen then
                    DropMenu.Visible = true
                    Refresh()
                    TweenService:Create(Arrow, TweenInfo.new(0.3), {Rotation = 90}):Play()
                    TweenService:Create(dropStroke, TweenInfo.new(0.2), {Color = Theme.StrokeAccent}):Play()
                else
                    TweenService:Create(DropMenu, TweenInfo.new(0.3), {
                        Size = UDim2.new(1, 0, 0, 0)
                    }):Play()
                    TweenService:Create(Arrow, TweenInfo.new(0.3), {Rotation = 0}):Play()
                    TweenService:Create(dropStroke, TweenInfo.new(0.2), {Color = Theme.Stroke}):Play()
                    task.delay(0.3, function()
                        if not isOpen then DropMenu.Visible = false end
                    end)
                end
            end)

            DropFrame.MouseEnter:Connect(function()
                if not isOpen then
                    TweenService:Create(dropStroke, TweenInfo.new(0.2), {Color = Theme.StrokeHover}):Play()
                    TweenService:Create(DropFrame, TweenInfo.new(0.2), {BackgroundColor3 = Theme.ElementBgHover}):Play()
                end
            end)
            DropFrame.MouseLeave:Connect(function()
                if not isOpen then
                    TweenService:Create(dropStroke, TweenInfo.new(0.2), {Color = Theme.Stroke}):Play()
                    TweenService:Create(DropFrame, TweenInfo.new(0.2), {BackgroundColor3 = Theme.ElementBg}):Play()
                end
            end)

            return DropFrame
        end

