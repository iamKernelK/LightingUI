    function Window:CreateTab(TabName, TabIcon)
        local Tab = {
            Path = Window.Path .. " → " .. TabName,
            Sections = {}
        }
        local isFirst = (#Sidebar:GetChildren() == 2)

        local TabBtn = Utility:Create("TextButton", {
            Size = UDim2.new(1, 0, 0, 40),
            BackgroundColor3 = Theme.ElementBg,
            BackgroundTransparency = isFirst and 0 or 1,
            Text = "",
            Parent = Sidebar
        })
        Utility:Create("UICorner", {CornerRadius = UDim.new(0, 6), Parent = TabBtn})
        
        local tabStroke = Utility:Create("UIStroke", {
            Color = Theme.Stroke,
            Parent = TabBtn
        })
        Utility:RegisterStroke(tabStroke)

        if TabIcon then
            local Icon = Utility:Create("ImageLabel", {
                Size = UDim2.new(0, 18, 0, 18),
                Position = UDim2.new(0, 10, 0.5, -9),
                BackgroundTransparency = 1,
                Image = TabIcon,
                ImageColor3 = isFirst and Theme.Accent or Theme.TextMuted,
                Parent = TabBtn
            })
            Utility:Create("TextLabel", {
                Size = UDim2.new(1, -35, 1, 0),
                Position = UDim2.new(0, 32, 0, 0),
                BackgroundTransparency = 1,
                Text = TabName,
                TextColor3 = isFirst and Theme.Accent or Theme.TextMuted,
                Font = Enum.Font.GothamMedium,
                TextSize = 14,
                TextXAlignment = Enum.TextXAlignment.Left,
                Parent = TabBtn
            })
        else
            Utility:Create("TextLabel", {
                Size = UDim2.new(1, -20, 1, 0),
                Position = UDim2.new(0, 15, 0, 0),
                BackgroundTransparency = 1,
                Text = TabName,
                TextColor3 = isFirst and Theme.Accent or Theme.TextMuted,
                Font = Enum.Font.GothamMedium,
                TextSize = 14,
                TextXAlignment = Enum.TextXAlignment.Left,
                Parent = TabBtn
            })
        end

        local Container = Utility:Create("ScrollingFrame", {
            Size = UDim2.new(1, 0, 1, -50),
            Position = UDim2.new(0, 0, 0, 50),
            BackgroundTransparency = 1,
            ScrollBarThickness = 2,
            Visible = isFirst,
            Parent = ContentArea
        })
        Utility:Create("UIListLayout", {Padding = UDim.new(0, 8), Parent = Container})
        Utility:Create("UIPadding", {
            PaddingTop = UDim.new(0, 5),
            PaddingLeft = UDim.new(0, 15),
            PaddingRight = UDim.new(0, 15),
            PaddingBottom = UDim.new(0, 20),
            Parent = Container
        })

        if isFirst then
            Window.ActiveTab = TabBtn
            TopTabName.Text = "| " .. TabName
        end

        -- Tab Click
        TabBtn.MouseButton1Click:Connect(function()
            if Window.ActiveTab == TabBtn then return end
            
            for _, child in ipairs(ContentArea:GetChildren()) do
                if child:IsA("ScrollingFrame") then child.Visible = false end
            end
            
            for _, btn in ipairs(Sidebar:GetChildren()) do
                if btn:IsA("TextButton") then
                    TweenService:Create(btn, TweenInfo.new(0.3), {BackgroundTransparency = 1}):Play()
                    local txt = btn:FindFirstChildOfClass("TextLabel")
                    if txt then txt.TextColor3 = Theme.TextMuted end
                    local img = btn:FindFirstChildOfClass("ImageLabel")
                    if img then img.ImageColor3 = Theme.TextMuted end
                end
            end
            
            Container.Visible = true
            TopTabName.Text = "| " .. TabName
            
            TweenService:Create(TabBtn, TweenInfo.new(0.3), {BackgroundTransparency = 0}):Play()
            local txt = TabBtn:FindFirstChildOfClass("TextLabel")
            if txt then txt.TextColor3 = Theme.Accent end
            local img = TabBtn:FindFirstChildOfClass("ImageLabel")
            if img then img.ImageColor3 = Theme.Accent end
            
            Window.ActiveTab = TabBtn
        end)

        TabBtn.MouseEnter:Connect(function()
            if Window.ActiveTab ~= TabBtn then
                TweenService:Create(TabBtn, TweenInfo.new(0.2), {BackgroundTransparency = 0.5}):Play()
            end
        end)
        TabBtn.MouseLeave:Connect(function()
            if Window.ActiveTab ~= TabBtn then
                TweenService:Create(TabBtn, TweenInfo.new(0.2), {BackgroundTransparency = 1}):Play()
            end
        end)

        -- ==========================================
        -- --- ELEMENT REGISTRY ---
        -- ==========================================
        local function RegisterElement(name, callback)
            table.insert(GlobalRegistry, {
                Name = name,
                Path = Tab.Path .. " → " .. name,
                Callback = function()
                    TabBtn.MouseButton1Click:Fire()
                    callback()
                end
            })
        end

        local function GetTarget(parent) return parent or Container end

