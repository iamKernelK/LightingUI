                Position = UDim2.new(1, -100, 0.5, -10),
                BackgroundTransparency = 1,
                Text = State and "ON" or "OFF",
                TextColor3 = State and Theme.Success or Theme.Danger,
                Font = Enum.Font.GothamBold,
                TextSize = 11,
                Parent = TogFrame
            })

            -- Toggle Switch Background
            local TogBg = Utility:Create("TextButton", {
                Size = UDim2.new(0, 44, 0, 24),
                Position = UDim2.new(1, -55, 0.5, -12),
                BackgroundColor3 = State and Theme.Success or Theme.Danger,
                Text = "",
                AutoButtonColor = false,
                Parent = TogFrame
            })
            Utility:Create("UICorner", {CornerRadius = UDim.new(1, 0), Parent = TogBg})
            
            -- Toggle Circle
            local TogCircle = Utility:Create("Frame", {
                Size = UDim2.new(0, 18, 0, 18),
                Position = State and UDim2.new(1, -21, 0, 3) or UDim2.new(0, 3, 0, 3),
                BackgroundColor3 = Color3.new(1,1,1),
                Parent = TogBg
            })
            Utility:Create("UICorner", {CornerRadius = UDim.new(1, 0), Parent = TogCircle})
            
            -- Glow effect
            local Glow = Utility:Create("Frame", {
                Size = UDim2.new(1, 4, 1, 4),
                Position = UDim2.new(0, -2, 0, -2),
                BackgroundColor3 = State and Theme.Success or Theme.Danger,
                BackgroundTransparency = 0.9,
                Parent = TogCircle
            })
            Utility:Create("UICorner", {CornerRadius = UDim.new(1, 0), Parent = Glow})

            local function Update()
                local targetColor = State and Theme.Success or Theme.Danger
                TweenService:Create(TogBg, TweenInfo.new(0.25), {
                    BackgroundColor3 = targetColor
                }):Play()
                TweenService:Create(TogCircle, TweenInfo.new(0.25), {
                    Position = State and UDim2.new(1, -21, 0, 3) or UDim2.new(0, 3, 0, 3)
                }):Play()
                TweenService:Create(StatusBar, TweenInfo.new(0.25), {
                    BackgroundColor3 = targetColor
                }):Play()
                StatusText.Text = State and "ON" or "OFF"
                StatusText.TextColor3 = targetColor
            end

            TogBg.MouseButton1Click:Connect(function()
                State = not State
                Update()
                Utility:AddRipple(TogBg)
                Callback(State)
            end)
            
            RegisterElement(Name, function() TogBg.MouseButton1Click:Fire() end)
            return TogFrame
        end

