    -- ==========================================
    -- 📑 Tab System
    -- ==========================================
    function Window:CreateTab(TabName)
        local Tab = {Path = Window.Path .. " -> " .. TabName}
        local isFirst = (#Sidebar:GetChildren() == 2)

        local TabBtn = Utility:Create("TextButton", {
            Size = UDim2.new(1, 0, 0, 35), BackgroundColor3 = Theme.ElementBg, BackgroundTransparency = isFirst and 0 or 1,
            Text = "  " .. TabName, TextColor3 = isFirst and Theme.Accent or Theme.TextMuted, Font = Enum.Font.GothamMedium, TextSize = 14, TextXAlignment = Enum.TextXAlignment.Left, Parent = Sidebar
        })
        Utility:Create("UICorner", {CornerRadius = UDim.new(0, 6), Parent = TabBtn})

        local Container = Utility:Create("ScrollingFrame", {
            Size = UDim2.new(1, 0, 1, -50), Position = UDim2.new(0, 0, 0, 50), BackgroundTransparency = 1, ScrollBarThickness = 2, Visible = isFirst, Parent = ContentArea
        })
        Utility:Create("UIListLayout", {Padding = UDim.new(0, 8), Parent = Container})
        Utility:Create("UIPadding", {PaddingTop = UDim.new(0, 5), PaddingLeft = UDim.new(0, 15), PaddingRight = UDim.new(0, 15), PaddingBottom = UDim.new(0, 20), Parent = Container})

        if isFirst then Window.ActiveTab = TabBtn; TopTabName.Text = "| " .. TabName end

        TabBtn.MouseButton1Click:Connect(function()
            if Window.ActiveTab == TabBtn then return end
            for _, child in ipairs(ContentArea:GetChildren()) do if child:IsA("ScrollingFrame") then child.Visible = false end end
            for _, btn in ipairs(Sidebar:GetChildren()) do
                if btn:IsA("TextButton") then
                    TweenService:Create(btn, TweenInfo.new(0.3), {BackgroundTransparency = 1}):Play()
                    btn.TextColor3 = Theme.TextMuted
                end
            end
            
            Container.Visible = true
            TopTabName.Text = "| " .. TabName
            TweenService:Create(TabBtn, TweenInfo.new(0.3), {BackgroundTransparency = 0}):Play()
            TabBtn.TextColor3 = Theme.Accent
            Window.ActiveTab = TabBtn

            -- Tab Open Animation (Slide and Fade)
            for _, elem in ipairs(Container:GetChildren()) do
                if elem:IsA("Frame") or elem:IsA("TextButton") then
                    elem.BackgroundTransparency = 1
                    local origPos = elem.Position
                    elem.Position = elem.Position + UDim2.new(0, 20, 0, 0)
                    TweenService:Create(elem, TweenInfo.new(0.4, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {BackgroundTransparency = 0, Position = origPos}):Play()
                end
            end
        end)

        -- Function to register elements to search
        local function RegisterElement(name, callback)
            table.insert(GlobalRegistry, {Name = name, Path = Tab.Path .. " -> " .. name, Callback = function()
                TabBtn.MouseButton1Click:Fire() -- Switch to tab
                callback()
            end})
        end

        -- Helpers
        local function GetTarget(parent) return parent or Container end

