            SecBtn.MouseButton1Click:Connect(function()
                isOpen = not isOpen
                SecTitle.Text = (isOpen and "> " or "v ") .. Name
                if isOpen then
                    TweenService:Create(SecFrame, TweenInfo.new(0.3), {Size = UDim2.new(1, 0, 0, 40 + layout.AbsoluteContentSize.Y + 15)}):Play()
                else
                    TweenService:Create(SecFrame, TweenInfo.new(0.3), {Size = UDim2.new(1, 0, 0, 40)}):Play()
                end
            end)

            layout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
                if isOpen then SecFrame.Size = UDim2.new(1, 0, 0, 40 + layout.AbsoluteContentSize.Y + 15) end
            end)

            return SecContent -- Return content frame for nesting
        end

