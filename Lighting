        -- 4. Slider
        function Tab:CreateSlider(Options, ParentTarget)
            local target = GetTarget(ParentTarget)
            local Name = Options.Name or "Slider"
            local Min = Options.Min or 0
            local Max = Options.Max or 100
            local Callback = Options.Callback or function() end

            local SliFrame = Utility:Create("Frame", {
                Size = UDim2.new(1, 0, 0, 55), BackgroundColor3 = Theme.ElementBg, Parent = target
            })
            Utility:Create("UICorner", {CornerRadius = UDim.new(0, 6), Parent = SliFrame})

            Utility:Create("TextLabel", {
                Size = UDim2.new(1, -20, 0, 20), Position = UDim2.new(0, 15, 0, 5), BackgroundTransparency = 1,
                Text = Name, TextColor3 = Theme.Text, Font = Enum.Font.GothamMedium, TextSize = 14, TextXAlignment = Enum.TextXAlignment.Left, Parent = SliFrame
            })

            local ValueBox = Utility:Create("TextBox", {
                Size = UDim2.new(0, 40, 0, 20), Position = UDim2.new(1, -55, 0, 5), BackgroundColor3 = Theme.Background,
                Text = tostring(Min), TextColor3 = Theme.Accent, Font = Enum.Font.GothamBold, TextSize = 12, Parent = SliFrame
            })
            Utility:Create("UICorner", {CornerRadius = UDim.new(0, 4), Parent = ValueBox})

            local Track = Utility:Create("TextButton", {
                Size = UDim2.new(1, -30, 0, 6), Position = UDim2.new(0, 15, 0, 35), BackgroundColor3 = Theme.Background, Text = "", AutoButtonColor = false, Parent = SliFrame
            })
            Utility:Create("UICorner", {CornerRadius = UDim.new(1, 0), Parent = Track})

            local Fill = Utility:Create("Frame", {
                Size = UDim2.new(0, 0, 1, 0), BackgroundColor3 = Theme.Accent, Parent = Track
            })
            Utility:Create("UICorner", {CornerRadius = UDim.new(1, 0), Parent = Fill})

            local dragging = false
            local function UpdateSlider(input)
                local pct = math.clamp((input.Position.X - Track.AbsolutePosition.X) / Track.AbsoluteSize.X, 0, 1)
                local val = math.floor(Min + (pct * (Max - Min)))
                TweenService:Create(Fill, TweenInfo.new(0.1), {Size = UDim2.new(pct, 0, 1, 0)}):Play()
                ValueBox.Text = tostring(val)
                Callback(val)
            end

            Track.InputBegan:Connect(function(inp) if inp.UserInputType == Enum.UserInputType.MouseButton1 then dragging = true; UpdateSlider(inp) end end)
            UserInputService.InputEnded:Connect(function(inp) if inp.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end end)
            UserInputService.InputChanged:Connect(function(inp) if dragging and inp.UserInputType == Enum.UserInputType.MouseMovement then UpdateSlider(inp) end end)
            
            RegisterElement(Name, function() end)
        end

