        Size = UDim2.new(0.5, -15, 0, 20),
        Position = UDim2.new(0.5, 0, 0.5, -10),
        BackgroundTransparency = 1,
        Text = tostring(Value), TextColor3 = Theme.Accent,
        Font = Enum.Font.GothamBold, TextSize = 13,
        TextXAlignment = Enum.TextXAlignment.Right,
        Parent = Container
    })

    Container.MouseEnter:Connect(function()
        TweenService:Create(Stroke, TweenInfo.new(0.2), {Color = Theme.StrokeHover}):Play()
        TweenService:Create(Container, TweenInfo.new(0.2), {BackgroundColor3 = Theme.ElementBgHover}):Play()
    end)
    Container.MouseLeave:Connect(function()
