    -- ==========================================
    -- --- SEARCH LOGIC (REALTIME) ---
    -- ==========================================
    local function PerformSearch(query)
        for _, v in ipairs(SearchScroll:GetChildren()) do
            if v:IsA("Frame") or v:IsA("TextLabel") or v:IsA("TextButton") then 
                v:Destroy() 
            end
        end
        
        if query == "" or query == nil then
            SearchMenu.Visible = false
            return
        end
        
        query = string.lower(query)
        local found = false
        
        for _, data in ipairs(GlobalRegistry) do
            if string.find(string.lower(data.Name), query, 1, true) then
                found = true
                
                local ResBtn = Utility:Create("TextButton", {
                    Size = UDim2.new(1, 0, 0, 50),
                    BackgroundColor3 = Theme.ElementBg,
                    Text = "",
                    Parent = SearchScroll
                })
                Utility:Create("UICorner", {CornerRadius = UDim.new(0, 6), Parent = ResBtn})
                
                local resStroke = Utility:Create("UIStroke", {
                    Color = Theme.Stroke,
                    Parent = ResBtn
                })
                Utility:RegisterStroke(resStroke)
                
                Utility:Create("TextLabel", {
                    Size = UDim2.new(1, -10, 0, 20),
                    Position = UDim2.new(0, 10, 0, 5),
                    BackgroundTransparency = 1,
                    Text = data.Name,
                    TextColor3 = Theme.Accent,
                    Font = Enum.Font.GothamBold,
                    TextSize = 14,
                    TextXAlignment = Enum.TextXAlignment.Left,
                    Parent = ResBtn
                })
                Utility:Create("TextLabel", {
                    Size = UDim2.new(1, -10, 0, 20),
                    Position = UDim2.new(0, 10, 0, 25),
                    BackgroundTransparency = 1,
                    Text = data.Path,
                    TextColor3 = Theme.TextMuted,
                    Font = Enum.Font.GothamMedium,
                    TextSize = 11,
                    TextXAlignment = Enum.TextXAlignment.Left,
                    Parent = ResBtn
                })
                
                ResBtn.MouseEnter:Connect(function()
                    TweenService:Create(ResBtn, TweenInfo.new(0.2), {BackgroundColor3 = Theme.Hover}):Play()
                end)
                ResBtn.MouseLeave:Connect(function()
                    TweenService:Create(ResBtn, TweenInfo.new(0.2), {BackgroundColor3 = Theme.ElementBg}):Play()
                end)
                
                ResBtn.MouseButton1Click:Connect(function()
                    SearchMenu.Visible = false
                    TopSearchBox.Text = ""
                    data.Callback()
                end)
            end
        end
        
        SearchScroll.CanvasSize = UDim2.new(0, 0, 0, #SearchScroll:GetChildren() * 55)
        SearchMenu.Visible = found
        
        if not found then
            Utility:Create("TextLabel", {
                Size = UDim2.new(1, 0, 0, 50),
                BackgroundTransparency = 1,
                Text = "❌ No results found for '" .. query .. "'",
                TextColor3 = Theme.TextMuted,
                Font = Enum.Font.GothamMedium,
                TextSize = 14,
                Parent = SearchScroll
            })
            SearchMenu.Visible = true
        end
    end

    TopSearchBox:GetPropertyChangedSignal("Text"):Connect(function()
        PerformSearch(TopSearchBox.Text)
    end)

