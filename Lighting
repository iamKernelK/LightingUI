-- ═══════════════════════════════════════════════════════════════════════════════
local NotificationGui = nil

local function InitNotificationSystem()
    NotificationGui = Instance.new("ScreenGui")
    NotificationGui.Name = "LightningUI_Notifications"
    NotificationGui.ResetOnSpawn = false
    NotificationGui.ZIndexBehavior = Enum.ZIndexBehavior.Global
    pcall(function() NotificationGui.Parent = gethui() end)
    if not NotificationGui.Parent then pcall(function() NotificationGui.Parent = CoreGui end) end
    if not NotificationGui.Parent then NotificationGui.Parent = LocalPlayer:WaitForChild("PlayerGui") end
end

function LightningUI:Notify(Type, Title, Message, Duration)
    Duration = Duration or 3
    if not NotificationGui then InitNotificationSystem() end

    local Colors = {
        Success = Theme.NotifSuccess, Error = Theme.NotifError,
        Warning = Theme.NotifWarning, Info = Theme.NotifInfo,
    }
    local Icons = {
        Success = "rbxassetid://7733715400", Error = "rbxassetid://7733658504",
        Warning = "rbxassetid://7733954760", Info = "rbxassetid://7733975348",
    }

    local NotifColor = Colors[Type] or Theme.NotifInfo
    local NotifIcon = Icons[Type] or Icons.Info

    local NotifFrame = Instance.new("Frame")
    NotifFrame.Size = UDim2.new(0, 320, 0, 0)
    NotifFrame.Position = UDim2.new(1, 20, 0.85, 0)
    NotifFrame.BackgroundColor3 = Theme.NotifBg
    NotifFrame.BorderSizePixel = 0
    NotifFrame.ClipsDescendants = true
    NotifFrame.Parent = NotificationGui

    Instance.new("UICorner", NotifFrame).CornerRadius = UDim.new(0, 10)

    local AccentBar = Instance.new("Frame")
    AccentBar.Size = UDim2.new(0, 4, 1, 0)
    AccentBar.BackgroundColor3 = NotifColor
    AccentBar.BorderSizePixel = 0
    AccentBar.Parent = NotifFrame
    Instance.new("UICorner", AccentBar).CornerRadius = UDim.new(0, 2)

    local Icon = Instance.new("ImageLabel")
    Icon.Size = UDim2.new(0, 24, 0, 24)
    Icon.Position = UDim2.new(0, 16, 0, 14)
    Icon.BackgroundTransparency = 1
    Icon.Image = NotifIcon
    Icon.ImageColor3 = NotifColor
    Icon.Parent = NotifFrame

    local TitleLabel = Instance.new("TextLabel")
    TitleLabel.Size = UDim2.new(1, -60, 0, 20)
    TitleLabel.Position = UDim2.new(0, 48, 0, 10)
    TitleLabel.BackgroundTransparency = 1
    TitleLabel.Text = Title
    TitleLabel.TextColor3 = Theme.Text
    TitleLabel.Font = Enum.Font.GothamBold
    TitleLabel.TextSize = 14
    TitleLabel.TextXAlignment = Enum.TextXAlignment.Left
    TitleLabel.Parent = NotifFrame

    local MsgLabel = Instance.new("TextLabel")
    MsgLabel.Size = UDim2.new(1, -60, 0, 0)
    MsgLabel.Position = UDim2.new(0, 48, 0, 30)
    MsgLabel.BackgroundTransparency = 1
    MsgLabel.Text = Message
    MsgLabel.TextColor3 = Theme.TextMuted
    MsgLabel.Font = Enum.Font.GothamMedium
    MsgLabel.TextSize = 12
    MsgLabel.TextXAlignment = Enum.TextXAlignment.Left
    MsgLabel.TextWrapped = true
    MsgLabel.Parent = NotifFrame

    local textBounds = TextService:GetTextSize(Message, 12, Enum.Font.GothamMedium, Vector2.new(250, 999))
    local finalHeight = math.max(60, 45 + textBounds.Y)

    local CloseBtn = Instance.new("TextButton")
    CloseBtn.Size = UDim2.new(0, 20, 0, 20)
    CloseBtn.Position = UDim2.new(1, -28, 0, 10)
    CloseBtn.BackgroundTransparency = 1
    CloseBtn.Text = "×"
    CloseBtn.TextColor3 = Theme.TextMuted
    CloseBtn.Font = Enum.Font.GothamBold
    CloseBtn.TextSize = 18
    CloseBtn.Parent = NotifFrame

    local Glow = Instance.new("Frame")
    Glow.Size = UDim2.new(1, 0, 0, 1)
    Glow.Position = UDim2.new(0, 0, 1, -1)
    Glow.BackgroundColor3 = NotifColor
    Glow.BackgroundTransparency = 0.7
    Glow.BorderSizePixel = 0
    Glow.Parent = NotifFrame

    local ProgressBar = Instance.new("Frame")
    ProgressBar.Size = UDim2.new(1, 0, 0, 2)
    ProgressBar.Position = UDim2.new(0, 0, 1, -2)
    ProgressBar.BackgroundColor3 = NotifColor
    ProgressBar.BorderSizePixel = 0
    ProgressBar.Parent = NotifFrame

    TweenService:Create(NotifFrame, TweenInfo.new(0.4, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
        Size = UDim2.new(0, 320, 0, finalHeight),
        Position = UDim2.new(1, -340, 0.85, 0)
    }):Play()

    TweenService:Create(ProgressBar, TweenInfo.new(Duration, Enum.EasingStyle.Linear), {
        Size = UDim2.new(0, 0, 0, 2)
    }):Play()

    local function CloseNotif()
        TweenService:Create(NotifFrame, TweenInfo.new(0.3, Enum.EasingStyle.Quart, Enum.EasingDirection.In), {
            Position = UDim2.new(1, 20, 0.85, 0),
            Size = UDim2.new(0, 320, 0, 0)
        }):Play()
        task.delay(0.3, function() NotifFrame:Destroy() end)
    end

    CloseBtn.MouseButton1Click:Connect(CloseNotif)
    task.delay(Duration, function()
        if NotifFrame and NotifFrame.Parent then CloseNotif() end
    end)
end

