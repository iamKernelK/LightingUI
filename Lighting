        function Tab:CreateDropdown(Options, ParentTarget)
            local target = GetTarget(ParentTarget)
            local Name = Options.Name or "Dropdown"
            local List = Options.Options or {}
            local Callback = Options.Callback or function() end

            local DropFrame = Utility:Create("Frame", {
                Size = UDim2.new(1, 0, 0, 50),
                BackgroundColor3 = Theme.ElementBg,
                Parent = target
            })
            Utility:Create("UICorner", {CornerRadius = UDim.new(0, 8), Parent = DropFrame})
            
            local dropStroke = Utility:Create("UIStroke", {
