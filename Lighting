                TextSize = 14,
                TextXAlignment = Enum.TextXAlignment.Left,
                Parent = SliFrame
            })

            local ValueBox = Utility:Create("TextBox", {
                Size = UDim2.new(0, 50, 0, 22),
                Position = UDim2.new(1, -65, 0, 7),
                BackgroundColor3 = Theme.Background,
                Text = tostring(Default),
                TextColor3 = Theme.Accent,
                Font = Enum.Font.GothamBold,
                TextSize = 12,
                Parent = SliFrame
            })
            Utility:Create("UICorner", {CornerRadius = UDim.new(0, 4), Parent = ValueBox})

            -- Min/Max labels
            Utility:Create("TextLabel", {
                Size = UDim2.new(0, 30, 0, 14),
                Position = UDim2.new(0, 15, 0, 48),
                BackgroundTransparency = 1,
                Text = tostring(Min),
                TextColor3 = Theme.TextMuted,
                Font = Enum.Font.GothamMedium,
                TextSize = 10,
                Parent = SliFrame
            })
            Utility:Create("TextLabel", {
                Size = UDim2.new(0, 30, 0, 14),
                Position = UDim2.new(1, -45, 0, 48),
                BackgroundTransparency = 1,
                Text = tostring(Max),
                TextColor3 = Theme.TextMuted,
                Font = Enum.Font.GothamMedium,
                TextSize = 10,
                TextXAlignment = Enum.TextXAlignment.Right,
                Parent = SliFrame
            })

            -- Track
            local Track = Utility:Create("TextButton", {
                Size = UDim2.new(1, -60, 0, 8),
                Position = UDim2.new(0, 30, 0, 38),
                BackgroundColor3 = Theme.Background,
                Text = "",
                AutoButtonColor = false,
                Parent = SliFrame
            })
            Utility:Create("UICorner", {CornerRadius = UDim.new(1, 0), Parent = Track})

            -- Fill
            local Fill = Utility:Create("Frame", {
                Size = UDim2.new((Default - Min) / (Max - Min), 0, 1, 0),
                BackgroundColor3 = Theme.Accent,
                Parent = Track
            })
            Utility:Create("UICorner", {CornerRadius = UDim.new(1, 0), Parent = Fill})

            -- Thumb (draggable circle)
            local Thumb = Utility:Create("Frame", {
                Size = UDim2.new(0, 16, 0, 16),
                Position = UDim2.new((Default - Min) / (Max - Min), -8, 0, -4),
                BackgroundColor3 = Color3.new(1, 1, 1),
                Parent = Track
            })
            Utility:Create("UICorner", {CornerRadius = UDim.new(1, 0), Parent = Thumb})
            local thumbStroke = Utility:Create("UIStroke", {
                Color = Theme.Accent,
                Thickness = 2,
                Parent = Thumb
            })

            local dragging = false
            local function UpdateSlider(input)
                local pct = math.clamp((input.Position.X - Track.AbsolutePosition.X) / Track.AbsoluteSize.X, 0, 1)
                local val = math.floor(Min + (pct * (Max - Min)))
                TweenService:Create(Fill, TweenInfo.new(0.1), {Size = UDim2.new(pct, 0, 1, 0)}):Play()
                TweenService:Create(Thumb, TweenInfo.new(0.1), {
                    Position = UDim2.new(pct, -8, 0, -4)
                }):Play()
                ValueBox.Text = tostring(val)
                Callback(val)
            end

            Track.InputBegan:Connect(function(inp)
                if inp.UserInputType == Enum.UserInputType.MouseButton1 then
                    dragging = true
                    UpdateSlider(inp)
                end
            end)
            UserInputService.InputEnded:Connect(function(inp)
                if inp.UserInputType == Enum.UserInputType.MouseButton1 then
                    dragging = false
                end
            end)
            UserInputService.InputChanged:Connect(function(inp)
                if dragging and inp.UserInputType == Enum.UserInputType.MouseMovement then
                    UpdateSlider(inp)
                end
            end)
            
            RegisterElement(Name, function() end)
            return SliFrame
        end

